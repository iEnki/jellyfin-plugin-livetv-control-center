<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.LiveTvGroups</RootNamespace>
    <Version>1.1.0.6</Version>
    <InformationalVersion>$(Version)-beta</InformationalVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Web\page.html" />
    <EmbeddedResource Include="Web\page.html" />
    <None Remove="Web\client.js" />
    <EmbeddedResource Include="Web\client.js" />
    <None Remove="Web\client.css" />
    <EmbeddedResource Include="Web\client.css" />
    <EmbeddedResource Include="Web\localization.js" />
    <EmbeddedResource Include="Web\channel-access.js" />
    <EmbeddedResource Include="Localization\strings.json" />
    <EmbeddedResource Include="..\..\assets\Live-TV_Control_Center_Logo.png" LogicalName="Jellyfin.Plugin.LiveTvGroups.Artwork.RootLogo.png" />
    <EmbeddedResource Include="..\..\assets\Live-TV_EPG.png" LogicalName="Jellyfin.Plugin.LiveTvGroups.Artwork.Epg.png" />
    <EmbeddedResource Include="..\..\assets\Live-TV_Program_List.png" LogicalName="Jellyfin.Plugin.LiveTvGroups.Artwork.ProgramList.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.LiveTvGroups.Tests" />
  </ItemGroup>

</Project>
